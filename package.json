{
  "name": "pm-autopilot",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "PM state machine for agent fleets as an omp custom-tool family: pm_lane / pm_apply / pm_audit / pm_release / pm_ledger / pm_walk_ledger / pm_walk",
  "omp": {
    "name": "pm-autopilot",
    "description": "pm-autopilot board tools: lane dispatch, guarded board writes, drift audit (walk-due rule 8), browser-lease + walk ledgers",
    "tools": "./src/tools.ts"
  },
  "files": [
    "src",
    "scripts",
    "agents",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "codegen": "graphql-codegen --config codegen.yml",
    "schema:sync": "node scripts/sync-schema.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.4",
    "@graphql-codegen/typescript": "^6.1.1",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@types/node": "^22.20.5",
    "graphql": "^16.14.2",
    "typescript": "~5.9.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.1",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/request": "^10.0.16",
    "execa": "^9.6.1",
    "octokit": "^5.0.5"
  }
}
